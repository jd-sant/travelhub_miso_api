# Copiar este archivo a .env y ajustar los valores
JWT_SECRET_KEY=travelhub-jwt-secret-change-in-prod
INTERNAL_API_KEY=dev-internal-key-change-me
ENV=development
APP_ENV=development

# Demo seed: cuando esta en true, users siembra dos hoteles demo con UUIDs fijos
# (sincronizados con properties/seed) y security acepta DEMO_OTP_CODE como OTP
# valido para los emails de DEMO_HOTEL_EMAILS. Mantener en false fuera de local.
DEMO_SEED_ENABLED=true
DEMO_HOTEL_EMAILS=hotel-a@travelhub.demo,hotel-b@travelhub.demo
DEMO_OTP_CODE=000000

# URLs entre servicios (docker-compose las inyecta automaticamente; aqui solo
# son utiles si se corren los uvicorn por fuera de docker).
USERS_SERVICE_URL=http://localhost:8000
PROPERTIES_SERVICE_URL=http://localhost:8005
PAYMENTS_SERVICE_URL=http://localhost:8003
RESERVATIONS_SERVICE_URL=http://localhost:8002

# Email SMTP (Gmail) - dejar SMTP_HOST vacio para usar LogOtpSender (logs OTP en consola)
# Para Gmail: habilitar 2FA y crear App Password en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password
SMTP_FROM=tu-email@gmail.com

PAYMENT_INTEGRITY_SECRET=travelhub-payments-secret-change-in-prod
PAYMENTS_DATA_ENCRYPTION_KEY=travelhub-payments-encryption-key-change-in-prod
PAYMENTS_COMPLIANCE_MODE=false
ENFORCE_TLS_HEADER=true
PRIVACY_COMPLIANCE_MODE=false
PII_DATA_ENCRYPTION_KEY=travelhub-pii-encryption-key-change-in-prod
USERS_PII_ENCRYPTION_ENABLED=false
USERS_PII_ENCRYPTION_KEY=travelhub-users-pii-encryption-key-change-in-prod
USERS_EMAIL_LOOKUP_HASH_SECRET=travelhub-users-email-lookup-hash-secret-change-in-prod
PRIVACY_AUDIT_ENABLED=false
DEFAULT_DATA_REGION=aws-us-east-1
DATA_RESIDENCY_POLICIES={"CO":"aws-us-east-1","US":"aws-us-east-1","BR":"aws-sa-east-1","ES":"aws-eu-west-1","PT":"aws-eu-west-1"}
PAYMENT_PROCESSING_RETRY_BASE_SECONDS=5
PAYMENT_PROCESSING_RETRY_MAX_BACKOFF_SECONDS=60
PAYMENT_PROCESSING_RETRY_MAX_ATTEMPTS=5
PAYMENT_PROCESSING_RETRY_BATCH_SIZE=50
# fake_stripe queda solo para desarrollo local automatizado. Para flujos de cumplimiento usar stripe_test.
PAYMENT_PROVIDER=fake_stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOWED_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Notifications
# Reutiliza INTERNAL_API_KEY para trafico interno y el bloque SMTP para envio de confirmaciones.
# Si SMTP_HOST queda vacio, notifications usa LogEmailSender en desarrollo.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=XXXX
AWS_SECRET_ACCESS_KEY=XXXX
AWS_SESSION_TOKEN=XXXX
# Scheduler
LAMBDA_ARN=arn:aws:lambda:us-east-1:ACC_ID:function:reservation-checker
SCHEDULER_ROLE_ARN=arn:aws:iam::ACC_ID:role/EventBridgeSchedulerRole
API_BASE_URL=http://reservations:8006
RESERVATION_SCHEDULER_ENABLED=true
RESERVATION_SCHEDULER_DELAY_MINUTES=15
PAYMENTS_SERVICE_URL=http://payments:8000
NOTIFICATIONS_SERVICE_URL=http://notifications:8000
NOTIFICATIONS_QUEUE_URL=
SES_FROM_ADDRESS=
SES_REGION=us-east-1
NOTIFICATIONS_DISPATCH_MODE=
DEFAULT_CANCELLATION_POLICY=Cancelacion gratuita hasta 48 horas antes del check-in. Despues se cobra la primera noche.
