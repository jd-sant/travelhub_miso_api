# Copiar este archivo a .env y ajustar los valores
JWT_SECRET_KEY=travelhub-jwt-secret-change-in-prod
INTERNAL_API_KEY=travelhub-internal-secret-key
ENV=development
APP_ENV=development

# Email SMTP (Gmail) - dejar SMTP_HOST vacio para usar LogOtpSender (logs OTP en consola)
# Para Gmail: habilitar 2FA y crear App Password en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password
SMTP_FROM=tu-email@gmail.com

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=XXXX
AWS_SECRET_ACCESS_KEY=XXXX
AWS_SESSION_TOKEN=XXXX
# Scheduler
LAMBDA_ARN=arn:aws:lambda:us-east-1:ACC_ID:function:reservation-checker
SCHEDULER_ROLE_ARN=arn:aws:iam::ACC_ID:role/EventBridgeSchedulerRole
API_BASE_URL=http://reservations:8002
RESERVATION_SCHEDULER_ENABLED=true
RESERVATION_SCHEDULER_DELAY_MINUTES=15
