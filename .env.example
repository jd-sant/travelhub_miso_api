# Copiar este archivo a .env y ajustar los valores
JWT_SECRET_KEY=travelhub-jwt-secret-change-in-prod
INTERNAL_API_KEY=travelhub-internal-secret-key
ENV=development
APP_ENV=development

# Email SMTP (Gmail) - dejar SMTP_HOST vacio para usar LogOtpSender (logs OTP en consola)
# Para Gmail: habilitar 2FA y crear App Password en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password
SMTP_FROM=tu-email@gmail.com

PAYMENT_INTEGRITY_SECRET=travelhub-payments-secret-change-in-prod
PAYMENTS_DATA_ENCRYPTION_KEY=travelhub-payments-encryption-key-change-in-prod
PAYMENTS_COMPLIANCE_MODE=false
# fake_stripe queda solo para desarrollo local automatizado. Para flujos de cumplimiento usar stripe_test.
PAYMENT_PROVIDER=fake_stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Notifications
# Reutiliza INTERNAL_API_KEY para trafico interno y el bloque SMTP para envio de confirmaciones.
# Si SMTP_HOST queda vacio, notifications usa LogEmailSender en desarrollo.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=XXXX
AWS_SECRET_ACCESS_KEY=XXXX
AWS_SESSION_TOKEN=XXXX
# Scheduler
LAMBDA_ARN=arn:aws:lambda:us-east-1:ACC_ID:function:reservation-checker
SCHEDULER_ROLE_ARN=arn:aws:iam::ACC_ID:role/EventBridgeSchedulerRole
API_BASE_URL=http://reservations:8006
RESERVATION_SCHEDULER_ENABLED=true
RESERVATION_SCHEDULER_DELAY_MINUTES=15
