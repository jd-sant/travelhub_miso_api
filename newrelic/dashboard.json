{
  "name": "TravelHub — Status Page & Golden Signals",
  "description": "Cuadro de mando unificado con semáforo de disponibilidad (DB, Pasarela de Pagos, Motor de Busqueda) y golden signals en tiempo real",
  "pages": [
    {
      "name": "Semaforo de Disponibilidad",
      "widgets": [
        {
          "title": "DB (PostgreSQL)",
          "visualization": {
            "id": "viz.billboard"
          },
          "configuration": {
            "billboard": {
              "thresholds": [
                { "alertSeverity": "CRITICAL", "value": 0 },
                { "alertSeverity": "NOT_ALERTING", "value": 1 }
              ],
              "nrqlQueries": [
                {
                  "accountId": 0,
                  "query": "SELECT filter(count(*), WHERE httpStatusCode = 200) / count(*) AS 'DB Disponible' FROM Transaction WHERE transactionType = 'Web' AND requestUri LIKE '%healthz/readiness%' AND appName = 'TravelHub-users' SINCE 5 minutes ago"
                }
              ]
            }
          },
          "layout": { "column": 1, "row": 1, "width": 4, "height": 3 }
        },
        {
          "title": "Pasarela de Pagos (Stripe)",
          "visualization": {
            "id": "viz.billboard"
          },
          "configuration": {
            "billboard": {
              "thresholds": [
                { "alertSeverity": "CRITICAL", "value": 0 },
                { "alertSeverity": "NOT_ALERTING", "value": 1 }
              ],
              "nrqlQueries": [
                {
                  "accountId": 0,
                  "query": "SELECT filter(count(*), WHERE result = 'SUCCESS') / count(*) AS 'Stripe Disponible' FROM SyntheticCheck WHERE monitorName = 'TravelHub External Health' AND domain LIKE '%stripe%' SINCE 5 minutes ago"
                }
              ]
            }
          },
          "layout": { "column": 5, "row": 1, "width": 4, "height": 3 }
        },
        {
          "title": "Motor de Busqueda",
          "visualization": {
            "id": "viz.billboard"
          },
          "configuration": {
            "billboard": {
              "thresholds": [
                { "alertSeverity": "CRITICAL", "value": 0 },
                { "alertSeverity": "NOT_ALERTING", "value": 1 }
              ],
              "nrqlQueries": [
                {
                  "accountId": 0,
                  "query": "SELECT filter(count(*), WHERE result = 'SUCCESS') / count(*) AS 'Search Disponible' FROM SyntheticCheck WHERE monitorName = 'TravelHub External Health' AND domain LIKE '%search%' SINCE 5 minutes ago"
                }
              ]
            }
          },
          "layout": { "column": 9, "row": 1, "width": 4, "height": 3 }
        },
        {
          "title": "Latencia P50 / P95 / P99",
          "visualization": {
            "id": "viz.line"
          },
          "configuration": {
            "line": {
              "nrqlQueries": [
                {
                  "accountId": 0,
                  "query": "SELECT percentile(duration, 50, 95, 99) FROM Transaction WHERE appName LIKE 'TravelHub%' AND transactionType = 'Web' SINCE 60 minutes ago TIMESERIES auto"
                }
              ]
            }
          },
          "layout": { "column": 1, "row": 4, "width": 6, "height": 3 }
        },
        {
          "title": "Trafico (RPM)",
          "visualization": {
            "id": "viz.area"
          },
          "configuration": {
            "area": {
              "nrqlQueries": [
                {
                  "accountId": 0,
                  "query": "SELECT rate(count(*), 1 minute) AS 'RPM' FROM Transaction WHERE appName LIKE 'TravelHub%' AND transactionType = 'Web' SINCE 60 minutes ago TIMESERIES auto"
                }
              ]
            }
          },
          "layout": { "column": 7, "row": 4, "width": 6, "height": 3 }
        },
        {
          "title": "Tasa de Error (5xx)",
          "visualization": {
            "id": "viz.line"
          },
          "configuration": {
            "line": {
              "nrqlQueries": [
                {
                  "accountId": 0,
                  "query": "SELECT percentage(count(*), WHERE httpStatusCode LIKE '5%') AS 'Error Rate %' FROM Transaction WHERE appName LIKE 'TravelHub%' AND transactionType = 'Web' SINCE 60 minutes ago TIMESERIES auto"
                }
              ]
            }
          },
          "layout": { "column": 1, "row": 7, "width": 6, "height": 3 }
        },
        {
          "title": "Saturacion (CPU / Memoria)",
          "visualization": {
            "id": "viz.line"
          },
          "configuration": {
            "line": {
              "nrqlQueries": [
                {
                  "accountId": 0,
                  "query": "SELECT average(cpuPercent) AS 'CPU %', average(memoryRssBytes / 1048576) AS 'Mem MB' FROM ProcessSample WHERE processDisplayName = 'uvicorn' AND containerImage LIKE 'travelhub-%' SINCE 60 minutes ago TIMESERIES auto"
                }
              ]
            }
          },
          "layout": { "column": 7, "row": 7, "width": 6, "height": 3 }
        }
      ]
    }
  ]
}
