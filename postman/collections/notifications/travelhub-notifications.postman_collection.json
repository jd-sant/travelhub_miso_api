{
  "info": {
    "_postman_id": "8b6bdf58-1fcb-4e65-94f1-2e5f4d9e7102",
    "name": "TravelHub Notifications MVP",
    "description": "Coleccion para validar el microservicio notifications y la confirmacion de pago de MPF-15 usando users y payments como fuentes de verdad.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "Health - Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health responde 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Health reporta healthy', function () {",
                  "  pm.expect(body.status).to.eql('healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{notifications_base_url}}/health",
              "host": [
                "{{notifications_base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01 - Contrato Interno",
      "item": [
        {
          "name": "Create Payment Confirmation - Wrong Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create payment confirmation forbidden 403', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Api-Key",
                "value": "invalid-key"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"{{$randomUUID}}\",\n  \"source_ip\": \"127.0.0.1\"\n}"
            },
            "url": {
              "raw": "{{notifications_base_url}}/api/v1/internal/payment-confirmations",
              "host": [
                "{{notifications_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "internal",
                "payment-confirmations"
              ]
            }
          }
        },
        {
          "name": "Get Notification By Id - Wrong Key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('notification_id', pm.variables.replaceIn('{{$randomUUID}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get notification forbidden 403', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "invalid-key"
              }
            ],
            "url": {
              "raw": "{{notifications_base_url}}/api/v1/notifications/{{notification_id}}",
              "host": [
                "{{notifications_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "notifications",
                "{{notification_id}}"
              ]
            }
          }
        },
        {
          "name": "Get Notification By Id - Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get notification not found 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": {
              "raw": "{{notifications_base_url}}/api/v1/notifications/{{notification_id}}",
              "host": [
                "{{notifications_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "notifications",
                "{{notification_id}}"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "notification_id",
      "value": ""
    }
  ]
}
