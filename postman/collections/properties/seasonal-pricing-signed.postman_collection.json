    {
      "name": "Create Seasonal Pricing",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('property_id', '11111111-1111-1111-1111-111111111111');",
              "pm.environment.set('base_url', 'http://localhost:8005');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
              "pm.test('Response contains signature_hash', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.signature_hash).to.exist;",
              "    pm.expect(jsonData.signature_hash.length).to.equal(64);",
              "});",
              "pm.test('Response indicates integrity_valid=true', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.integrity_valid).to.equal(true);",
              "    pm.expect(jsonData.integrity_locked).to.equal(false);",
              "});",
              "pm.test('Store pricing ID for subsequent tests', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('seasonal_price_id', jsonData.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"season_start\": \"2026-06-01\",\n  \"season_end\": \"2026-08-31\",\n  \"price_per_night\": 1500.0,\n  \"currency\": \"COP\",\n  \"tax_rate\": 0.19,\n  \"cleaning_fee\": 500.0\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/properties/{{property_id}}/seasonal-pricing",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "properties", "{{property_id}}", "seasonal-pricing"]
        }
      }
    },
    {
      "name": "Get Seasonal Pricing (Single)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has integrity_valid=true', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.integrity_valid).to.equal(true);",
              "});",
              "pm.test('Signature hash matches created price', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.signature_hash).to.exist;",
              "    pm.expect(jsonData.price_per_night).to.equal(1500.0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/properties/{{property_id}}/seasonal-pricing/{{seasonal_price_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "properties", "{{property_id}}", "seasonal-pricing", "{{seasonal_price_id}}"]
        }
      }
    },
    {
      "name": "List Seasonal Pricing",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is paginated list', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.items).to.be.an('array');",
              "    pm.expect(jsonData.total).to.be.a('number');",
              "});",
              "pm.test('All items have integrity_valid field', function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.items.forEach(function(item) { pm.expect(item.integrity_valid).to.exist; });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/properties/{{property_id}}/seasonal-pricing",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "properties", "{{property_id}}", "seasonal-pricing"]
        }
      }
    },
    {
      "name": "Update Seasonal Pricing",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Price has been updated', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.price_per_night).to.equal(2000.0);",
              "});",
              "pm.test('Signature has changed after update', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.signature_hash).to.exist;",
              "    pm.expect(jsonData.integrity_valid).to.equal(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"season_start\": \"2026-06-01\",\n  \"season_end\": \"2026-08-31\",\n  \"price_per_night\": 2000.0,\n  \"currency\": \"COP\",\n  \"tax_rate\": 0.19,\n  \"cleaning_fee\": 500.0\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/properties/{{property_id}}/seasonal-pricing/{{seasonal_price_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "properties", "{{property_id}}", "seasonal-pricing", "{{seasonal_price_id}}"]
        }
      }
    },
    {
      "name": "Create with Ownership Check (Should Fail)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 403 Forbidden', function () { pm.response.to.have.status(403); });",
              "pm.test('Response indicates ownership error', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.detail).to.include('does not own');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{wrong_admin_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"season_start\": \"2026-09-01\",\n  \"season_end\": \"2026-09-30\",\n  \"price_per_night\": 1200.0,\n  \"currency\": \"COP\",\n  \"tax_rate\": 0.19,\n  \"cleaning_fee\": 500.0\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/properties/{{property_id}}/seasonal-pricing",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "properties", "{{property_id}}", "seasonal-pricing"]
        }
      }
    },
