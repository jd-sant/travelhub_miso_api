{
  "info": {
    "name": "TravelHub Seasonal Pricing with Digital Signature",
    "description": "Collection for testing seasonal pricing endpoints with HMAC-SHA256 signature verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "seasonal-pricing-collection-2026"
  },
  "item": [
    {
      "name": "Auth - Login Hotel A",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Hotel A login 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{security_base_url}}/api/v1/auth/login",
          "host": ["{{security_base_url}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "Auth - Verify OTP Hotel A",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Hotel A OTP 200', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.environment.set('admin_token', jsonData.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"otp_code\": \"{{demo_otp_code}}\"\n}"
        },
        "url": {
          "raw": "{{security_base_url}}/api/v1/auth/verify-otp",
          "host": ["{{security_base_url}}"],
          "path": ["api", "v1", "auth", "verify-otp"]
        }
      }
    },
