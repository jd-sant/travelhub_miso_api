          "path": ["api", "v1", "properties", "{{property_id}}", "seasonal-pricing", "00000000-0000-0000-0000-000000000000"]
        }
      }
    },
    {
      "name": "Create Multiple Seasons",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
              "pm.test('Pricing for different season created', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.season_start).to.equal('2026-12-01');",
              "    pm.expect(jsonData.season_end).to.equal('2026-12-31');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"season_start\": \"2026-12-01\",\n  \"season_end\": \"2026-12-31\",\n  \"price_per_night\": 3000.0,\n  \"currency\": \"COP\",\n  \"tax_rate\": 0.19,\n  \"cleaning_fee\": 750.0\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/properties/{{property_id}}/seasonal-pricing",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "properties", "{{property_id}}", "seasonal-pricing"]
        }
      }
    }
  ],
