          "raw": "{{security_base_url}}/api/v1/auth/login",
          "host": ["{{security_base_url}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "Auth - Verify OTP Hotel B",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Hotel B OTP 200', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.environment.set('wrong_admin_token', jsonData.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
