{
  "info": {
    "_postman_id": "12f45be6-8be0-4ecb-a661-4f11775365ec",
    "name": "TravelHub Reservations Contract",
    "description": "Validaciones contract/smoke para Reservations service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health - Reservations",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('health 200', function () { pm.response.to.have.status(200); });"]}}],
      "request": {"method": "GET", "header": [], "url": {"raw": "{{reservations_base_url}}/health", "host": ["{{reservations_base_url}}"], "path": ["health"]}}
    },
    {
      "name": "Create Traveler For Reservation Flows",
      "event": [
        {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["const suffix = Date.now();", "pm.collectionVariables.set('shared_traveler_email', `reservations.contract.${suffix}@travelhub.demo`);", "pm.collectionVariables.set('shared_traveler_phone', `31${String(suffix).slice(-8)}`);"]}},
        {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('create traveler 201', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.collectionVariables.set('shared_traveler_id', body.id);"]}}
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{shared_traveler_email}}\",\n  \"phone\": \"{{shared_traveler_phone}}\",\n  \"password\": \"Travelhub123!\",\n  \"full_name\": \"Reservations Contract Traveler\",\n  \"country_code\": \"CO\",\n  \"role\": \"traveler\"\n}"},
        "url": {"raw": "{{users_base_url}}/api/v1/users", "host": ["{{users_base_url}}"], "path": ["api", "v1", "users"]}
      }
    },
    {
      "name": "Create Reservation",
      "event": [
        {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["const now = new Date();", "const checkIn = new Date(now.getTime() + 5 * 24 * 60 * 60 * 1000);", "const checkOut = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);", "pm.collectionVariables.set('res_traveler_id', pm.collectionVariables.get('shared_traveler_id'));", "pm.collectionVariables.set('res_property_id', '11111111-1111-1111-1111-111111111111');", "pm.collectionVariables.set('res_room_id', pm.variables.replaceIn('{{$randomUUID}}'));", "pm.collectionVariables.set('res_check_in', checkIn.toISOString());", "pm.collectionVariables.set('res_check_out', checkOut.toISOString());"]}},
        {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('create reservation 201', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.test('status pending_payment', function () { pm.expect(body.status).to.eql('pending_payment'); });", "pm.collectionVariables.set('reservation_id', body.id);"]}}
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"id_traveler\": \"{{res_traveler_id}}\",\n  \"id_property\": \"{{res_property_id}}\",\n  \"id_room\": \"{{res_room_id}}\",\n  \"check_in_date\": \"{{res_check_in}}\",\n  \"check_out_date\": \"{{res_check_out}}\",\n  \"number_of_guests\": 2,\n  \"currency\": \"COP\"\n}"},
        "url": {"raw": "{{reservations_base_url}}/api/v1/reservations", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations"]}
      }
    },
    {
      "name": "Get Reservation",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('get reservation 200', function () { pm.response.to.have.status(200); });"]}}],
      "request": {"method": "GET", "header": [], "url": {"raw": "{{reservations_base_url}}/api/v1/reservations/{{reservation_id}}", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations", "{{reservation_id}}"]}}
    },
    {
      "name": "CheckStatus Cancels Pending",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('checkstatus 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('status_after cancelled', function () { pm.expect(body.status_after).to.eql('cancelled'); });"]}}],
      "request": {"method": "POST", "header": [{"key": "X-Internal-Api-Key", "value": "{{internal_api_key}}"}], "url": {"raw": "{{reservations_base_url}}/api/v1/internal/reservations/{{reservation_id}}/checkstatus", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "internal", "reservations", "{{reservation_id}}", "checkstatus"]}}
    },
    {
      "name": "Create Confirmed Reservation For Preview",
      "event": [
        {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["const now = new Date();", "const checkIn = new Date(now.getTime() + 5 * 24 * 60 * 60 * 1000);", "const checkOut = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);", "pm.collectionVariables.set('preview_traveler_id', pm.collectionVariables.get('shared_traveler_id'));", "pm.collectionVariables.set('preview_property_id', '11111111-1111-1111-1111-111111111111');", "pm.collectionVariables.set('preview_room_id', pm.variables.replaceIn('{{$randomUUID}}'));", "pm.collectionVariables.set('preview_check_in', checkIn.toISOString());", "pm.collectionVariables.set('preview_check_out', checkOut.toISOString());"]}},
        {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('create preview reservation 201', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.collectionVariables.set('preview_reservation_id', body.id);", "pm.collectionVariables.set('preview_original_check_in', body.check_in_date);", "pm.collectionVariables.set('preview_original_check_out', body.check_out_date);"]}}
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"id_traveler\": \"{{preview_traveler_id}}\",\n  \"id_property\": \"{{preview_property_id}}\",\n  \"id_room\": \"{{preview_room_id}}\",\n  \"check_in_date\": \"{{preview_check_in}}\",\n  \"check_out_date\": \"{{preview_check_out}}\",\n  \"number_of_guests\": 2,\n  \"currency\": \"COP\"\n}"},
        "url": {"raw": "{{reservations_base_url}}/api/v1/reservations", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations"]}
      }
    },
    {
      "name": "Confirm Preview Reservation",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('confirm preview reservation 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('preview reservation confirmed', function () { pm.expect(body.status_after).to.eql('confirmed'); });"]}}],
      "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Internal-Api-Key", "value": "{{internal_api_key}}"}], "body": {"mode": "raw", "raw": "{\n  \"status\": \"confirmed\"\n}"}, "url": {"raw": "{{reservations_base_url}}/api/v1/internal/reservations/{{preview_reservation_id}}/status", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "internal", "reservations", "{{preview_reservation_id}}", "status"]}}
    },
    {
      "name": "Preview Modification",
      "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["const now = new Date();", "const checkIn = new Date(now.getTime() + 6 * 24 * 60 * 60 * 1000);", "const checkOut = new Date(now.getTime() + 9 * 24 * 60 * 60 * 1000);", "pm.collectionVariables.set('preview_mod_check_in', checkIn.toISOString());", "pm.collectionVariables.set('preview_mod_check_out', checkOut.toISOString());"]}}, {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('modification preview 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('modification allowed', function () { pm.expect(body.change_allowed).to.eql(true); });", "pm.test('additional charge required', function () { pm.expect(body.requires_additional_charge).to.eql(true); });", "pm.test('delta amount present', function () { pm.expect(body.delta_amount).to.match(/^\\d+(\\.\\d{2})$/); });"]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"check_in_date\": \"{{preview_mod_check_in}}\",\n  \"check_out_date\": \"{{preview_mod_check_out}}\",\n  \"number_of_guests\": 3\n}"}, "url": {"raw": "{{reservations_base_url}}/api/v1/reservations/{{preview_reservation_id}}/modifications/preview", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations", "{{preview_reservation_id}}", "modifications", "preview"]}}
    },
    {
      "name": "Preview Cancellation",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('cancellation preview 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('cancellation allowed', function () { pm.expect(body.change_allowed).to.eql(true); });", "pm.test('refund amount present', function () { pm.expect(body.refund_amount).to.match(/^\\d+(\\.\\d{2})$/); });", "pm.test('no penalty', function () { pm.expect(body.penalty_amount).to.eql('0.00'); });"]}}],
      "request": {"method": "POST", "header": [], "url": {"raw": "{{reservations_base_url}}/api/v1/reservations/{{preview_reservation_id}}/cancellation/preview", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations", "{{preview_reservation_id}}", "cancellation", "preview"]}}
    },
    {
      "name": "Confirm Modification",
      "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["if (!pm.collectionVariables.get('mod_confirm_idempotency_key')) {", "  pm.collectionVariables.set('mod_confirm_idempotency_key', `mod-confirm-${Date.now()}`);", "}"]}}, {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('confirm modification 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('modification pending payment', function () { pm.expect(body.status_after).to.eql('modification_pending_payment'); });", "pm.collectionVariables.set('mod_confirm_idempotency_key', body.idempotency_key);"]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Traveler-Id", "value": "{{preview_traveler_id}}"}], "body": {"mode": "raw", "raw": "{\n  \"idempotency_key\": \"{{mod_confirm_idempotency_key}}\",\n  \"check_in_date\": \"{{preview_mod_check_in}}\",\n  \"check_out_date\": \"{{preview_mod_check_out}}\",\n  \"number_of_guests\": 3\n}"}, "url": {"raw": "{{reservations_base_url}}/api/v1/reservations/{{preview_reservation_id}}/modifications/confirm", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations", "{{preview_reservation_id}}", "modifications", "confirm"]}}
    },
    {
      "name": "Confirm Modification Replay Idempotent",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('confirm modification replay 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('same idempotency key returned', function () { pm.expect(body.idempotency_key).to.eql(pm.collectionVariables.get('mod_confirm_idempotency_key')); });"]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Traveler-Id", "value": "{{preview_traveler_id}}"}], "body": {"mode": "raw", "raw": "{\n  \"idempotency_key\": \"{{mod_confirm_idempotency_key}}\",\n  \"check_in_date\": \"{{preview_mod_check_in}}\",\n  \"check_out_date\": \"{{preview_mod_check_out}}\",\n  \"number_of_guests\": 3\n}"}, "url": {"raw": "{{reservations_base_url}}/api/v1/reservations/{{preview_reservation_id}}/modifications/confirm", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations", "{{preview_reservation_id}}", "modifications", "confirm"]}}
    },
    {
      "name": "Apply Additional Charge Callback - Failed",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('additional charge callback 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('status_after additional_charge_failed', function () { pm.expect(body.status_after).to.eql('additional_charge_failed'); });"]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Internal-Api-Key", "value": "{{internal_api_key}}"}], "body": {"mode": "raw", "raw": "{\n  \"status\": \"failed\",\n  \"payment_id\": \"{{$randomUUID}}\",\n  \"amount_in_cents\": 11900\n}"}, "url": {"raw": "{{reservations_base_url}}/api/v1/internal/reservations/{{preview_reservation_id}}/additional-charge-result", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "internal", "reservations", "{{preview_reservation_id}}", "additional-charge-result"]}}
    },
    {
      "name": "Get Reservation - Additional Charge Failed",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('get reservation after additional charge failure 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('status additional_charge_failed', function () { pm.expect(body.status).to.eql('additional_charge_failed'); });", "pm.test('check_in remains original', function () {", "  pm.expect(body.check_in_date).to.eql(pm.collectionVariables.get('preview_original_check_in'));", "});", "pm.test('check_out remains original', function () {", "  pm.expect(body.check_out_date).to.eql(pm.collectionVariables.get('preview_original_check_out'));", "});"]}}],
      "request": {"method": "GET", "header": [{"key": "X-Traveler-Id", "value": "{{preview_traveler_id}}"}], "url": {"raw": "{{reservations_base_url}}/api/v1/reservations/{{preview_reservation_id}}", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations", "{{preview_reservation_id}}"]}}
    },
    {
      "name": "Get Reservation History",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('history 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('history has events', function () { pm.expect(body.events.length).to.be.greaterThan(0); });", "const hasConfirmEvent = body.events.some((e) => e.event_type === 'modification_confirmed');", "pm.test('history contains modification_confirmed', function () { pm.expect(hasConfirmEvent).to.eql(true); });"]}}],
      "request": {"method": "GET", "header": [{"key": "X-Traveler-Id", "value": "{{preview_traveler_id}}"}], "url": {"raw": "{{reservations_base_url}}/api/v1/reservations/{{preview_reservation_id}}/history", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations", "{{preview_reservation_id}}", "history"]}}
    },
    {
      "name": "Create Confirmed Reservation For Cancellation Confirm",
      "event": [
        {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["const now = new Date();", "const checkIn = new Date(now.getTime() + 5 * 24 * 60 * 60 * 1000);", "const checkOut = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);", "pm.collectionVariables.set('cancel_traveler_id', pm.collectionVariables.get('shared_traveler_id'));", "pm.collectionVariables.set('cancel_property_id', '11111111-1111-1111-1111-111111111111');", "pm.collectionVariables.set('cancel_room_id', pm.variables.replaceIn('{{$randomUUID}}'));", "pm.collectionVariables.set('cancel_check_in', checkIn.toISOString());", "pm.collectionVariables.set('cancel_check_out', checkOut.toISOString());", "pm.collectionVariables.set('cancel_confirm_idempotency_key', `cancel-confirm-${Date.now()}`);"]}},
        {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('create cancel reservation 201', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.collectionVariables.set('cancel_reservation_id', body.id);"]}}
      ],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"id_traveler\": \"{{cancel_traveler_id}}\",\n  \"id_property\": \"{{cancel_property_id}}\",\n  \"id_room\": \"{{cancel_room_id}}\",\n  \"check_in_date\": \"{{cancel_check_in}}\",\n  \"check_out_date\": \"{{cancel_check_out}}\",\n  \"number_of_guests\": 2,\n  \"currency\": \"COP\"\n}"}, "url": {"raw": "{{reservations_base_url}}/api/v1/reservations", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations"]}}
    },
    {
      "name": "Confirm Reservation For Cancellation",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('confirm cancellation target 200', function () { pm.response.to.have.status(200); });"]}}],
      "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Internal-Api-Key", "value": "{{internal_api_key}}"}], "body": {"mode": "raw", "raw": "{\n  \"status\": \"confirmed\"\n}"}, "url": {"raw": "{{reservations_base_url}}/api/v1/internal/reservations/{{cancel_reservation_id}}/status", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "internal", "reservations", "{{cancel_reservation_id}}", "status"]}}
    },
    {
      "name": "Confirm Cancellation",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('confirm cancellation 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('status cancel_requested', function () { pm.expect(body.status_after).to.eql('cancel_requested'); });", "pm.test('refund amount present', function () { pm.expect(body.refund_amount).to.match(/^\\d+(\\.\\d{2})$/); });"]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Traveler-Id", "value": "{{cancel_traveler_id}}"}], "body": {"mode": "raw", "raw": "{\n  \"idempotency_key\": \"{{cancel_confirm_idempotency_key}}\",\n  \"reason\": \"traveler request\"\n}"}, "url": {"raw": "{{reservations_base_url}}/api/v1/reservations/{{cancel_reservation_id}}/cancellation/confirm", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations", "{{cancel_reservation_id}}", "cancellation", "confirm"]}}
    }
  ]
}
