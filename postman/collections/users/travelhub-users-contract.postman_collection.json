  "item": [
    {
      "name": "Health - Users",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('health 200', function () { pm.response.to.have.status(200); });"]}}],
      "request": {"method": "GET", "header": [], "url": {"raw": "{{users_base_url}}/health", "host": ["{{users_base_url}}"], "path": ["health"]}}
    },
    {
      "name": "Internal Verify Credentials - Wrong API Key",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('verify credentials forbidden 403', function () { pm.response.to.have.status(403); });"]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Internal-Api-Key", "value": "invalid-key"}],
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"no-user@example.com\",\n  \"password\": \"bad-pass\"\n}"},
        "url": {"raw": "{{users_base_url}}/api/v1/internal/verify-credentials", "host": ["{{users_base_url}}"], "path": ["api", "v1", "internal", "verify-credentials"]}
      }
    }
  ]
