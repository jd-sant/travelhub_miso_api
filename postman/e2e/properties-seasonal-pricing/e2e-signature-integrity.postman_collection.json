    {
      "name": "Step 6 - List All Seasonal Pricing",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('[E2E Step 6] HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('[E2E Step 6] List contains created pricing', function () {",
              "    var jsonData = pm.response.json();",
              "    var found = jsonData.items.some(function(item) {",
              "        return item.id === pm.environment.get('created_pricing_id');",
              "    });",
              "    pm.expect(found).to.equal(true);",
              "});",
              "",
              "pm.test('[E2E Step 6] All items have integrity_valid field', function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.items.forEach(function(item) {",
              "        pm.expect(item.integrity_valid).to.exist;",
              "        pm.expect(item.signature_hash).to.exist;",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/properties/11111111-1111-1111-1111-111111111111/seasonal-pricing",
