    {
      "name": "Step 1 - Create Seasonal Price (Happy Path)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('test_season_start', '2026-06-01');",
              "pm.environment.set('test_season_end', '2026-08-31');",
              "pm.environment.set('test_price', 2500);",
              "pm.environment.set('test_tax_rate', 0.19);",
              "pm.environment.set('test_cleaning_fee', 600);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('[E2E Step 1] HTTP 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('[E2E Step 1] Response has valid signature_hash (64 chars)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.signature_hash).to.be.a('string');",
              "    pm.expect(jsonData.signature_hash.length).to.equal(64);",
              "    pm.environment.set('created_signature', jsonData.signature_hash);",
              "});",
              "",
              "pm.test('[E2E Step 1] Response integrity_valid=true and integrity_locked=false', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.integrity_valid).to.equal(true);",
              "    pm.expect(jsonData.integrity_locked).to.equal(false);",
              "});",
              "",
              "pm.test('[E2E Step 1] Pricing record created with correct fields', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.price_per_night).to.equal(2500);",
              "    pm.expect(jsonData.tax_rate).to.equal(0.19);",
              "    pm.expect(jsonData.cleaning_fee).to.equal(600);",
              "    pm.expect(jsonData.season_start).to.equal('2026-06-01');",
              "    pm.expect(jsonData.season_end).to.equal('2026-08-31');",
              "    pm.environment.set('created_pricing_id', jsonData.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"season_start\": \"{{test_season_start}}\",\n  \"season_end\": \"{{test_season_end}}\",\n  \"price_per_night\": {{test_price}},\n  \"currency\": \"COP\",\n  \"tax_rate\": {{test_tax_rate}},\n  \"cleaning_fee\": {{test_cleaning_fee}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/properties/11111111-1111-1111-1111-111111111111/seasonal-pricing",
          "host": ["{{base_url}}"],
          "path": [
            "api",
            "v1",
            "properties",
            "11111111-1111-1111-1111-111111111111",
            "seasonal-pricing"
          ]
        }
      }
    },
    {
      "name": "Step 2 - Read Created Price (100% Signature Validation)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('[E2E Step 2] HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('[E2E Step 2] Signature matches on read', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.signature_hash).to.equal(pm.environment.get('created_signature'));",
              "});",
              "",
              "pm.test('[E2E Step 2] integrity_valid=true (100% validation passed)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.integrity_valid).to.equal(true);",
              "    pm.expect(jsonData.integrity_locked).to.equal(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/properties/11111111-1111-1111-1111-111111111111/seasonal-pricing/{{created_pricing_id}}",
          "host": ["{{base_url}}"],
          "path": [
            "api",
            "v1",
            "properties",
            "11111111-1111-1111-1111-111111111111",
            "seasonal-pricing",
            "{{created_pricing_id}}"
          ]
        }
      }
    },
    {
      "name": "Step 3 - Create Additional Pricing (Different Season)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Create pricing for a different season to test multiple records",
              "pm.environment.set('alt_season_start', '2026-09-01');",
              "pm.environment.set('alt_season_end', '2026-10-31');",
              "pm.environment.set('alt_price', 2800);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('[E2E Step 3] HTTP 201 Created for additional pricing', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('[E2E Step 3] New pricing has valid signature', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.signature_hash).to.exist;",
              "    pm.expect(jsonData.signature_hash.length).to.equal(64);",
              "    pm.expect(jsonData.integrity_valid).to.equal(true);",
              "});",
              "",
              "pm.test('[E2E Step 3] Different season generates different signature', function () {",
              "    var jsonData = pm.response.json();",
              "    var originalSig = pm.environment.get('created_signature');",
              "    pm.expect(jsonData.signature_hash).to.not.equal(originalSig);",
              "    pm.environment.set('alt_pricing_id', jsonData.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"season_start\": \"{{alt_season_start}}\",\n  \"season_end\": \"{{alt_season_end}}\",\n  \"price_per_night\": {{alt_price}},\n  \"currency\": \"COP\",\n  \"tax_rate\": {{test_tax_rate}},\n  \"cleaning_fee\": {{test_cleaning_fee}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/properties/11111111-1111-1111-1111-111111111111/seasonal-pricing",
          "host": ["{{base_url}}"],
          "path": [
            "api",
            "v1",
            "properties",
            "11111111-1111-1111-1111-111111111111",
            "seasonal-pricing"
          ]
        }
