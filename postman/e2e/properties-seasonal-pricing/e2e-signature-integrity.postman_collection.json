    {
      "name": "Step 4 - Update Valid Pricing (New Signature)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('updated_price', 3000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('[E2E Step 4] HTTP 200 OK on update', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('[E2E Step 4] Updated price reflected', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.price_per_night).to.equal(3000);",
              "});",
              "",
              "pm.test('[E2E Step 4] Signature changed after price update', function () {",
              "    var jsonData = pm.response.json();",
              "    var oldSig = pm.environment.get('created_signature');",
              "    pm.expect(jsonData.signature_hash).to.not.equal(oldSig);",
              "    pm.expect(jsonData.integrity_valid).to.equal(true);",
              "    pm.environment.set('updated_signature', jsonData.signature_hash);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"season_start\": \"{{test_season_start}}\",\n  \"season_end\": \"{{test_season_end}}\",\n  \"price_per_night\": {{updated_price}},\n  \"currency\": \"COP\",\n  \"tax_rate\": {{test_tax_rate}},\n  \"cleaning_fee\": {{test_cleaning_fee}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/properties/11111111-1111-1111-1111-111111111111/seasonal-pricing/{{created_pricing_id}}",
          "host": ["{{base_url}}"],
          "path": [
            "api",
            "v1",
            "properties",
            "11111111-1111-1111-1111-111111111111",
            "seasonal-pricing",
            "{{created_pricing_id}}"
          ]
        }
      }
    },
    {
      "name": "Step 5 - Verify Updated Signature",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('[E2E Step 5] HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('[E2E Step 5] Signature matches latest update', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.signature_hash).to.equal(pm.environment.get('updated_signature'));",
              "});",
              "",
              "pm.test('[E2E Step 5] Updated price returned on read', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.price_per_night).to.equal(3000);",
              "    pm.expect(jsonData.integrity_valid).to.equal(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/properties/11111111-1111-1111-1111-111111111111/seasonal-pricing/{{created_pricing_id}}",
