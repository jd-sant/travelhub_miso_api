    {
      "name": "Step 7 - Ownership Validation (Should Fail with 403)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('different_admin', pm.environment.get('wrong_admin_token'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('[E2E Step 7] HTTP 403 Forbidden for non-owner', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test('[E2E Step 7] Error message indicates ownership', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.detail).to.include('does not own');",
              "});"
            ]
          }
        }
      ],
