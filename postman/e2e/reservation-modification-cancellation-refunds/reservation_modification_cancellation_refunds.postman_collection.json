    {
      "name": "Create Reservation - Cancellation Scenario",
      "event": [
        {"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["const now = new Date();", "const checkIn = new Date(now.getTime() + 5 * 24 * 60 * 60 * 1000);", "const checkOut = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);", "pm.collectionVariables.set('cancel_traveler_id', pm.variables.replaceIn('{{$randomUUID}}'));", "pm.collectionVariables.set('cancel_property_id', '11111111-1111-1111-1111-111111111111');", "pm.collectionVariables.set('cancel_room_id', pm.variables.replaceIn('{{$randomUUID}}'));", "pm.collectionVariables.set('cancel_check_in', checkIn.toISOString());", "pm.collectionVariables.set('cancel_check_out', checkOut.toISOString());", "pm.collectionVariables.set('cancel_payment_idempotency', `e2e-cancel-pay-${Date.now()}`);", "pm.collectionVariables.set('cancel_confirm_idempotency', `e2e-cancel-confirm-${Date.now()}`);"]}},
        {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('create reservation 201', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.collectionVariables.set('cancel_reservation_id', body.id);"]}}
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"id_traveler\": \"{{cancel_traveler_id}}\",\n  \"id_property\": \"{{cancel_property_id}}\",\n  \"id_room\": \"{{cancel_room_id}}\",\n  \"check_in_date\": \"{{cancel_check_in}}\",\n  \"check_out_date\": \"{{cancel_check_out}}\",\n  \"number_of_guests\": 2,\n  \"currency\": \"COP\"\n}"},
        "url": {"raw": "{{reservations_base_url}}/api/v1/reservations", "host": ["{{reservations_base_url}}"], "path": ["api", "v1", "reservations"]}
      }
    },
    {
      "name": "Create Payment - Cancellation Scenario",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('payment 201', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.test('payment confirmed', function () { pm.expect(body.status).to.eql('confirmed'); });"]}}],
