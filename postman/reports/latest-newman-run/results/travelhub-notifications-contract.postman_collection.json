      {
        "id": "fe898f9f-151f-49f9-af1a-2c95f0551b0f",
        "name": "Create Reservation Event Notification",
        "request": {
          "url": {
            "path": [
              "api",
              "v1",
              "internal",
              "reservation-events"
            ],
            "host": [
              "{{notifications_base_url}}"
            ],
            "query": [],
            "variable": []
          },
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "X-Internal-Api-Key",
              "value": "{{internal_api_key}}"
            }
          ],
          "method": "POST",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"reservation_id\": \"{{reservation_id}}\",\n  \"traveler_id\": \"{{traveler_id}}\",\n  \"event_type\": \"refund_succeeded\",\n  \"payment_id\": \"{{payment_id}}\",\n  \"refund_id\": \"{{refund_id}}\",\n  \"source_ip\": \"127.0.0.1\"\n}"
          }
        },
        "response": [],
        "event": [
          {
            "listen": "prerequest",
            "script": {
              "id": "b6e29b04-0006-4c42-9fc1-fcf6449c114a",
              "type": "text/javascript",
              "exec": [
                "pm.collectionVariables.set('reservation_id', pm.variables.replaceIn('{{$randomUUID}}'));",
                "pm.collectionVariables.set('traveler_id', pm.variables.replaceIn('{{$randomUUID}}'));",
                "pm.collectionVariables.set('payment_id', pm.variables.replaceIn('{{$randomUUID}}'));",
                "pm.collectionVariables.set('refund_id', pm.variables.replaceIn('{{$randomUUID}}'));"
              ],
              "_lastExecutionId": "528195ac-7c93-4a6c-b066-d41a59be5ab9"
            }
          },
          {
            "listen": "test",
            "script": {
              "id": "d4b9cda7-c398-4f7e-b61b-efae11e222ee",
              "type": "text/javascript",
              "exec": [
                "pm.test('created 201', function () { pm.response.to.have.status(201); });",
                "const body = pm.response.json();",
                "pm.test('response includes pending status', function () { pm.expect(body.status).to.eql('pending'); });",
                "pm.test('response echoes payment id', function () { pm.expect(body.payment_id).to.eql(pm.collectionVariables.get('payment_id')); });",
                "pm.collectionVariables.set('notification_id', body.notification_id);"
              ],
              "_lastExecutionId": "0f6c1076-3835-40e6-8bd2-1b8559c256a0"
            }
          }
        ]
      }
