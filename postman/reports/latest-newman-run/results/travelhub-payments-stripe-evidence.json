        "name": "01 - Config",
        "item": [
          {
            "id": "00b12f7d-8d1f-46d4-81f9-3d84fed2fc70",
            "name": "Get Payments Config",
            "request": {
              "url": {
                "path": [
                  "api",
                  "v1",
                  "payments",
                  "config"
                ],
                "host": [
                  "{{payments_base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "3b2e8749-0259-4723-8c70-5bb7a3bdec6d",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Config responde 200', function () {",
                    "  pm.response.to.have.status(200);",
                    "});",
                    "const body = pm.response.json();",
                    "pm.test('Provider valido', function () {",
                    "  pm.expect(['fake_stripe', 'stripe_test']).to.include(body.provider);",
                    "});",
                    "pm.test('Consistencia de stripe_enabled', function () {",
                    "  if (body.provider === 'stripe_test') { pm.expect(body.stripe_enabled).to.eql(true); }",
                    "  if (body.provider === 'fake_stripe') { pm.expect(body.stripe_enabled).to.eql(false); }",
                    "});",
                    "pm.test('Consistencia de publishable_key', function () {",
                    "  if (body.provider === 'stripe_test') { pm.expect(body.publishable_key).to.match(/^pk_test_/); }",
                    "  if (body.provider === 'fake_stripe') { pm.expect(body.publishable_key).to.eql(''); }",
                    "});"
                  ],
                  "_lastExecutionId": "0b7a4d7f-8c25-4019-a8e7-c4f13f43f423"
                }
              }
            ]
          }
        ],
        "event": []
      },
