            "raw": "{\n  \"id_traveler\": \"{{res_traveler_id}}\",\n  \"id_property\": \"{{res_property_id}}\",\n  \"id_room\": \"{{res_room_id}}\",\n  \"check_in_date\": \"{{res_check_in}}\",\n  \"check_out_date\": \"{{res_check_out}}\",\n  \"number_of_guests\": 2,\n  \"currency\": \"COP\"\n}"
