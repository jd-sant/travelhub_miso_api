            "script": {
              "id": "3015a1f8-a9ea-4c79-92da-e55924bfdf58",
              "type": "text/javascript",
              "exec": [
                "const now = new Date();",
                "const checkIn = new Date(now.getTime() + 5 * 24 * 60 * 60 * 1000);",
                "const checkOut = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);",
                "pm.collectionVariables.set('res_traveler_id', pm.variables.replaceIn('{{$randomUUID}}'));",
                "pm.collectionVariables.set('res_property_id', pm.variables.replaceIn('{{$randomUUID}}'));",
                "pm.collectionVariables.set('res_room_id', pm.variables.replaceIn('{{$randomUUID}}'));",
                "pm.collectionVariables.set('res_check_in', checkIn.toISOString());",
                "pm.collectionVariables.set('res_check_out', checkOut.toISOString());"
              ],
              "_lastExecutionId": "b073d2d4-713f-4a81-bc52-5827ba28f799"
            }
          },
          {
            "listen": "test",
            "script": {
              "id": "e4007330-efd5-4a09-aaec-a1fdc86ea9c9",
              "type": "text/javascript",
              "exec": [
                "pm.test('create reservation 201', function () { pm.response.to.have.status(201); });",
                "const body = pm.response.json();",
                "pm.test('status pending_payment', function () { pm.expect(body.status).to.eql('pending_payment'); });",
                "pm.collectionVariables.set('reservation_id', body.id);"
