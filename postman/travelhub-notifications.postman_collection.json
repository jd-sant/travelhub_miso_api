{
  "info": {
    "_postman_id": "8b6bdf58-1fcb-4e65-94f1-2e5f4d9e7102",
    "name": "TravelHub Notifications MVP",
    "description": "Coleccion para validar el microservicio notifications y la confirmacion de pago de MPF-15 usando users y payments como fuentes de verdad.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "Health - Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health responde 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Health reporta healthy', function () {",
                  "  pm.expect(body.status).to.eql('healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{notifications_base_url}}/health",
              "host": [
                "{{notifications_base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01 - Preparacion",
      "item": [
        {
          "name": "Create Traveler",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('traveler_email', `traveler+${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create traveler responde 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('traveler_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{traveler_email}}\",\n  \"phone\": \"3001234567\",\n  \"password\": \"Password123!\",\n  \"full_name\": \"Ana Traveler\",\n  \"role\": \"traveler\",\n  \"status\": 1\n}"
            },
            "url": {
              "raw": "{{users_base_url}}/api/v1/users",
              "host": [
                "{{users_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Pago Base",
      "item": [
        {
          "name": "Create Charge - Success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('reservation_id', pm.variables.replaceIn('{{$randomUUID}}'));",
                  "pm.collectionVariables.set('payments_idempotency_key', `notif-${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create charge responde 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Pago queda confirmado', function () {",
                  "  pm.expect(body.status).to.eql('confirmed');",
                  "});",
                  "pm.collectionVariables.set('payment_id', body.payment_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Forwarded-Proto",
                "value": "https"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservation_id\": \"{{reservation_id}}\",\n  \"traveler_id\": \"{{traveler_id}}\",\n  \"payment_method_token\": \"pm_tok_visa_ok\",\n  \"amount_in_cents\": 287650,\n  \"currency\": \"COP\",\n  \"idempotency_key\": \"{{payments_idempotency_key}}\"\n}"
            },
            "url": {
              "raw": "{{payments_base_url}}/api/v1/payments/charges",
              "host": [
                "{{payments_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "charges"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Confirmacion de Pago",
      "item": [
        {
          "name": "Create Payment Confirmation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crea confirmacion y responde 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve notification_id', function () {",
                  "  pm.expect(body.notification_id).to.be.a('string');",
                  "});",
                  "pm.test('La notificacion queda en estado sent', function () {",
                  "  pm.expect(body.status).to.eql('sent');",
                  "});",
                  "pm.collectionVariables.set('notification_id', body.notification_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"{{payment_id}}\",\n  \"source_ip\": \"127.0.0.1\"\n}"
            },
            "url": {
              "raw": "{{notifications_base_url}}/api/v1/internal/payment-confirmations",
              "host": [
                "{{notifications_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "internal",
                "payment-confirmations"
              ]
            }
          }
        },
        {
          "name": "Get Notification By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consulta notificacion responde 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve la misma notificacion creada', function () {",
                  "  pm.expect(body.notification_id).to.eql(pm.collectionVariables.get('notification_id'));",
                  "});",
                  "pm.test('El estado se mantiene en sent', function () {",
                  "  pm.expect(body.status).to.eql('sent');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": {
              "raw": "{{notifications_base_url}}/api/v1/notifications/{{notification_id}}",
              "host": [
                "{{notifications_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "notifications",
                "{{notification_id}}"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "traveler_email",
      "value": ""
    },
    {
      "key": "traveler_id",
      "value": ""
    },
    {
      "key": "reservation_id",
      "value": ""
    },
    {
      "key": "payments_idempotency_key",
      "value": ""
    },
    {
      "key": "payment_id",
      "value": ""
    },
    {
      "key": "notification_id",
      "value": ""
    }
  ]
}
